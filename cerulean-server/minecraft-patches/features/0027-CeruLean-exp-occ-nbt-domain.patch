+    // ================= CeruLean start - EXP6: 实体 NBT 数据域（OCC 第四域） =================
+    // 与 upstream（AzureBranches 的 azurepatches-src 整文件覆盖）等价的三件事：
+    //   ① 读：把 NbtPath 命中的读值按 (实体 id, 路径各段) 记进 PhaseSnapshot 的 NBT 读集；
+    //   ② 写：把"写前值 / 写后值"记进写缓存，供 PhaseValidator 校验与回滚补偿；
+    //   ③ merge：无路径的整 compound 合并 → 做顶层浅 diff 后逐项记写。
+    // 只对 EntityDataAccessor 生效（方块/存储访问器不走这套；方块域由 Level.getBlockState 钩子负责）。
+    // 非 EXP 链上下文 snap == null ⇒ 全部零成本 no-op。
+
+    /** 把 Tag 归一化成"自有值"，便于快照持有（数字/字符串取标量，其余深拷贝）。 */
+    private static Object leafValue(final net.minecraft.nbt.Tag tag) {
+        if (tag == null) {
+            return null;
+        }
+        if (tag instanceof net.minecraft.nbt.NumericTag numericTag) {
+            return numericTag.box();
+        }
+        if (tag instanceof net.minecraft.nbt.StringTag stringTag) {
+            return stringTag.value();
+        }
+        return tag.copy();
+    }
+
+    /** 在内存 compound 上解析路径，取第一个命中的叶子值。 */
+    private static Object readLeaf(final NbtPathArgument.NbtPath path, final CompoundTag data) throws CommandSyntaxException {
+        final java.util.Collection<net.minecraft.nbt.Tag> tags = path.get(data);
+        return tags.isEmpty() ? null : leafValue(tags.iterator().next());
+    }
+
+    /** 记录一次实体 NBT 路径读。 */
+    private static void interceptEntityRead(
+        final com.azurebranches.command.PhaseSnapshot snap,
+        final DataAccessor accessor,
+        final NbtPathArgument.NbtPath path,
+        final net.minecraft.nbt.Tag liveTag
+    ) {
+        if (snap == null || !(accessor instanceof EntityDataAccessor entityAccessor)) {
+            return;
+        }
+        final String[] parts = com.azurebranches.command.EntityLayer.parsePathString(path.asString());
+        com.azurebranches.command.EntityLayer.recordReadValue(
+            snap, entityAccessor.entityId(), parts[0], parts[1], parts[2], leafValue(liveTag), 0L);
+    }
+
+    /** 记录一次实体 NBT 路径写（newVal == oldVal 时无净变化，跳过）。 */
+    private static void interceptEntityWrite(
+        final com.azurebranches.command.PhaseSnapshot snap,
+        final DataAccessor accessor,
+        final NbtPathArgument.NbtPath path,
+        final Object newVal,
+        final Object oldVal
+    ) {
+        if (snap == null || !(accessor instanceof EntityDataAccessor entityAccessor)) {
+            return;
+        }
+        if (java.util.Objects.equals(newVal, oldVal)) {
+            return;
+        }
+        final String[] parts = com.azurebranches.command.EntityLayer.parsePathString(path.asString());
+        com.azurebranches.command.EntityLayer.interceptWrite(
+            snap, entityAccessor.entityId(), parts[0], parts[1], parts[2], newVal, oldVal);
+    }
+
+    /** 记录无路径的 `/data merge` 写：对前后 compound 做顶层浅 diff。 */
+    private static void interceptEntityMergeWrite(
+        final com.azurebranches.command.PhaseSnapshot snap,
+        final DataAccessor accessor,
+        final CompoundTag before,
+        final CompoundTag after
+    ) {
+        if (snap == null || !(accessor instanceof EntityDataAccessor entityAccessor)) {
+            return;
+        }
+        for (final String name : after.keySet()) {
+            final net.minecraft.nbt.Tag beforeTag = before.get(name);
+            final net.minecraft.nbt.Tag afterTag = after.get(name);
+            if (!java.util.Objects.equals(beforeTag, afterTag)) {
+                com.azurebranches.command.EntityLayer.interceptWrite(
+                    snap, entityAccessor.entityId(), name, null, null, leafValue(afterTag), leafValue(beforeTag));
+            }
+        }
+    }
+    // ================= CeruLean end - EXP6 entity NBT domain =================
+
