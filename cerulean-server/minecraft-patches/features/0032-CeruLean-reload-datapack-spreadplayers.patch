+    /**
+     * CeruLean: 把 `/spreadplayers` 整体派发到**中心位置所属区域**的 tick 线程。
+     *
+     * <p>为什么必须这样：候选位置的落点计算（`Position.getSpawnY` / `Position.isSafe`）
+     * 要读方块，而 `Level.getBlockState` 在区域线程之外会 NPE
+     * （`getCurrentWorldData()` 为 null）；传送本身在 Folia 上也只能走 `teleportAsync`。</p>
+     *
+     * <p>命令立即返回 1，实际散布与反馈在目标区域线程上完成（反馈经 `runOnSource` 送回源）。
+     * **已知限制**：`maxRange` 大到跨多个区域时，候选位置的方块读仍发生在中心区域线程上，
+     * 严格来说应逐位置派发（upstream 的 378 行覆盖层也只处理了传送 Y）。</p>
+     */
+    private static int spreadPlayersDispatch(
+        final com.mojang.brigadier.context.CommandContext<CommandSourceStack> c,
+        final Vec2 center,
+        final float spreadDistance,
+        final float maxRange,
+        final int maxHeight,
+        final boolean respectTeams,
+        final Collection<? extends Entity> entities
+    ) {
+        final CommandSourceStack source = c.getSource();
+        final net.minecraft.server.level.ServerLevel level = source.getLevel();
+        final int cx = Mth.floor(center.x) >> 4;
+        final int cz = Mth.floor(center.y) >> 4;
+        RegionCommandExecutor.<Void>onBlockRegionAsync(level, cx, cz, () -> {
+            try {
+                spreadPlayers(source, center, spreadDistance, maxRange, maxHeight, respectTeams, entities);
+            } catch (final com.mojang.brigadier.exceptions.CommandSyntaxException e) {
+                RegionCommandExecutor.runOnSource(source, () ->
+                    source.sendFailure(net.minecraft.network.chat.Component.literal(e.getRawMessage().getString())));
+            } catch (final Throwable t) {
+                RegionCommandExecutor.runOnSource(source, () ->
+                    source.sendFailure(net.minecraft.network.chat.Component.literal("spreadplayers failed: " + t)));
+            }
+            return null;
+        });
+        return 1;
+    }
+
