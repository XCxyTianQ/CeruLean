diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index 48f7eb2..3a02e0b 100644
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -276,6 +276,25 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
     private boolean usingWhitelist;
     private float smoothedTickTimeMillis;
     private final Executor executor;
+    /**
+     * CeruLean: 把"主线程执行器"语义映射到 Folia 的**全局区域 tick 线程**。
+     *
+     * <p>Folia 没有传统意义的主线程，`MinecraftServer.execute(...)` 在 tick 线程上是非法的
+     * （会把 blockable event loop 的队列交给永不 drain 的地方）。资源重载的
+     * `SimpleReloadInstance` 需要 `mainThreadExecutor.execute(...)` 来推进 barrier/apply 阶段，
+     * 因此这里提供一个"投递到全局 tick 队列"的执行器：非阻塞、且语义正确。</p>
+     */
+    private final Executor globalTickExecutor = task -> {
+        final io.papermc.paper.threadedregions.RegionizedServer rs =
+            io.papermc.paper.threadedregions.RegionizedServer.getInstance();
+        if (rs == null) {
+            // 启动早期（全局调度器尚未建立）退化为后台池。
+            // 注意不能引用 this.executor：字段初始化早于构造函数里的赋值。
+            Util.backgroundExecutor().execute(task);
+        } else {
+            rs.addTask(task);
+        }
+    };
     private @Nullable String serverId;
     private MinecraftServer.ReloadableResources resources;
     private final StructureTemplateManager structureTemplateManager;
@@ -2443,7 +2462,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
