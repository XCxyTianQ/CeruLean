+    // CeruLean start - 跨区域/跨维度搬运方块刻
+    // 原生 copyAreaFrom 假定 source 与 this 处于**同一个区域容器**：Folia 下 Level.getBlockTicks()
+    // 取的是按区域划分的容器（ServerLevel:2219 → RegionizedWorldData#getBlockLevelTicks），
+    // 于是跨区域调用时 source 参数要么指向错的容器、要么直接命中 "World mismatch"。
+    // 因此拆成"源区域抓纯数据快照 / 目标区域按快照排定"两步，语义与 copyAreaFrom 逐行等价。
+    public List<ScheduledTick<T>> cerulean$snapshotArea(final BoundingBox area) {
+        final List<ScheduledTick<T>> ticksToAdd = new ArrayList<>();
+        final Predicate<ScheduledTick<T>> tickInsideBB = t -> area.isInside(t.pos());
+        this.alreadyRunThisTick.stream().filter(tickInsideBB).forEach(ticksToAdd::add);
+        this.toRunThisTick.stream().filter(tickInsideBB).forEach(ticksToAdd::add);
+        this.forContainersInArea(area, (pos, container) -> container.getAll().filter(tickInsideBB).forEach(ticksToAdd::add));
+        return ticksToAdd;
+    }
+
+    /** 与 {@link #copyAreaFrom} 的下半段逐行等价（含 subTickOrder 重排）。 */
+    public void cerulean$scheduleSnapshot(final List<ScheduledTick<T>> ticks, final Vec3i offset) {
+        if (ticks.isEmpty()) {
+            return;
+        }
+        final LongSummaryStatistics info = ticks.stream().mapToLong(ScheduledTick::subTickOrder).summaryStatistics();
+        final long minSubTick = info.getMin();
+        final long maxSubTick = info.getMax();
+        ticks.forEach(
+            tick -> this.schedule(
+                new ScheduledTick<>(
+                    tick.type(), tick.pos().offset(offset), tick.triggerTick(), tick.priority(), tick.subTickOrder() - minSubTick + maxSubTick + 1L
+                )
+            )
+        );
+    }
+    // CeruLean end - 跨区域/跨维度搬运方块刻
+
     @Override
     public int count() {
         return this.allContainers.values().stream().mapToInt(TickAccess::count).sum();
