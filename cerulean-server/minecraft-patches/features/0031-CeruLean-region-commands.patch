diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index 4d20afb..48f7eb2 100644
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -2429,7 +2429,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
                     .filter(Objects::nonNull)
                     .flatMap(Pack::open)
                     .collect(ImmutableList.toImmutableList()),
-                this
+                this.executor
             )
             .thenCompose(
                 packsToLoad -> {
@@ -2453,7 +2453,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
                         .thenApply(managers -> new MinecraftServer.ReloadableResources(resources, managers));
                 }
             )
-            .thenAcceptAsync(newResources -> {
+            .thenCompose(newResources -> this.runOnGlobalTick(() -> {
                 io.papermc.paper.command.brigadier.PaperBrigadier.moveBukkitCommands(this.resources.managers().getCommands(), newResources.managers().getCommands()); // Paper
                 this.resources.close();
                 this.resources = newResources;
@@ -2483,14 +2483,34 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
                 this.server.syncCommands(); // Refresh commands after event
                 // Paper end
                 new io.papermc.paper.event.server.ServerResourcesReloadedEvent(cause).callEvent(); // Paper - Add ServerResourcesReloadedEvent; fire after everything has been reloaded
-            }, this);
-        if (this.isSameThread()) {
+            }));
+        // CeruLean: 在 tick 线程（全局区域线程）上**不得阻塞** —— Folia 的 managedBlock 会抛
+        // UnsupportedOperationException，进而把整个全局区域 tick 打死（实测会导致关服）。
+        // 上游那段变换已经把"应用到全局状态"的部分改成 runOnGlobalTick 异步完成，
+        // 所以这里对 tick 线程直接异步返回；命令反馈由 ReloadCommand 自行处理。
+        if (this.isSameThread() && !ca.spottedleaf.moonrise.common.util.TickThread.isTickThread()) {
             this.managedBlock(result::isDone);
         }
 
         return result;
     }
 
+    // AzureBranches EXP5 P1: run a task on the global tick thread and
+    // expose it as a CompletableFuture, so reloadResources applies global
+    // state changes on the main thread (Folia removed the server executor).
+    private CompletableFuture<Void> runOnGlobalTick(final Runnable task) {
+        final CompletableFuture<Void> future = new CompletableFuture<>();
+        io.papermc.paper.threadedregions.RegionizedServer.getInstance().addTask(() -> {
+            try {
+                task.run();
+                future.complete(null);
+            } catch (final Throwable t) {
+                future.completeExceptionally(t);
+            }
+        });
+        return future;
+    }
+
     public static WorldDataConfiguration configurePackRepository(
         final PackRepository packRepository, final WorldDataConfiguration initialDataConfig, final boolean initMode, final boolean safeMode
     ) {
